{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "gad-home",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "gad-home"
		}
	],
	"vars": {
		"NEXT_PUBLIC_SITE_URL": "https://gad-home.youssef-m-a-zahran.workers.dev",
		"NEXT_PUBLIC_MEDIA_BASE_URL": "https://br-aged-mode-ba4mu3qe.storage.c-8.eu-central-1.aws.neon.tech/media",
		"NEXT_PUBLIC_LEGACY_MEDIA_BASE_URL": "https://ocsqswnttstxhhmidntj.supabase.co/storage/v1/object/public/media",
		"STORAGE_ENDPOINT": "https://br-aged-mode-ba4mu3qe.storage.c-8.eu-central-1.aws.neon.tech",
		"STORAGE_REGION": "eu-central-1"
	}
}
