NEXT_PUBLIC_SITE_URL=https://gad-home.youssef-m-a-zahran.workers.dev
# Neon Object Storage (bucket "media"); new uploads are stored as full URLs under this base.
NEXT_PUBLIC_MEDIA_BASE_URL=https://br-aged-mode-ba4mu3qe.storage.c-8.eu-central-1.aws.neon.tech/media
# Photos uploaded before the move to Neon are bare paths that still live in Supabase Storage.
NEXT_PUBLIC_LEGACY_MEDIA_BASE_URL=https://ocsqswnttstxhhmidntj.supabase.co/storage/v1/object/public/media
STORAGE_ENDPOINT=https://br-aged-mode-ba4mu3qe.storage.c-8.eu-central-1.aws.neon.tech
STORAGE_REGION=eu-central-1

# Secrets: never commit. On Cloudflare set them with `wrangler secret put <NAME>` (or Settings -> Variables and Secrets).
# Locally put them in .env.local.
# DATABASE_URL=postgresql://...neon.tech/neondb?sslmode=require   (pooled connection string of Neon project gad-home)
# STORAGE_ACCESS_KEY_ID=...
# STORAGE_SECRET_ACCESS_KEY=...
# ADMIN_SETUP_CODE=...   (only needed to let an admin email without a password create it on /admin/login)
